# Create an app at https://developer.spotify.com/dashboard
VITE_SPOTIFY_CLIENT_ID=your_spotify_client_id

# Must exactly match a redirect URI configured in the Spotify app dashboard.
# Local example: http://127.0.0.1:5174/
# Pages example: https://YOUR_USERNAME.github.io/YOUR_REPOSITORY/
VITE_SPOTIFY_REDIRECT_URI=http://127.0.0.1:5174/

# Use / locally. GitHub Actions sets /REPOSITORY_NAME/ during deployment.
VITE_BASE_PATH=/
